{
  "name": "library-manager",
  "version": "1.0.0",
  "description": "Library Management System with 3-Tier Architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:memory": "DATA_SOURCE=memory node server.js",
    "start:memory:win": "set DATA_SOURCE=memory&& node server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "swap-test": "node scripts/swap-test.js",
    "check-layers": "node scripts/check-layers.js",
    "verify": "npm run check-layers && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
